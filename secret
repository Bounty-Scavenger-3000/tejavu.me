<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tejas — The Desk</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Fraunces:opsz,wght@9..144,400;9..144,600&family=IBM+Plex+Sans:wght@400;500&family=Space+Mono:wght@400;700&family=Caveat:wght@600;700&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════════════════
   TEJAS PORTFOLIO v3 — THE DESK (front view)
   Layout: Metal cabinet (left) | Desk (centre) | Corkboard (right)
   desk-demo-v2.html — update in place, never create new file
   ═══════════════════════════════════════════════ */

*{box-sizing:border-box;margin:0;padding:0;}
html,body{width:100%;height:100%;overflow:hidden;background:#0a0812;}
@media(prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;transition-duration:.01ms!important;}}

/* ── ROOM ── */
#room{
  width:100vw;height:100vh;
  display:flex;align-items:center;justify-content:center;
  position:relative;overflow:hidden;
  background:
    radial-gradient(ellipse 90% 60% at 50% 10%, rgba(40,20,80,0.55) 0%, transparent 65%),
    linear-gradient(180deg,#0a0812 0%,#0e0a14 40%,#14100a 70%,#0a0806 100%);
  transition:opacity .5s ease;
}
/* CRT scanlines */
#room::after{content:"";position:absolute;inset:0;pointer-events:none;z-index:998;
  background:repeating-linear-gradient(0deg,rgba(0,0,0,.12) 0,rgba(0,0,0,.12) 1px,transparent 1px,transparent 3px);}

/* stars */
.star{position:absolute;width:2px;height:2px;background:#fff;opacity:0;animation:tw var(--d,3s) var(--dl,0s) ease-in-out infinite;}
@keyframes tw{0%,100%{opacity:0;}50%{opacity:var(--op,.4);}}

/* ambient purple wall glow from top */
.wall-glow{position:absolute;top:0;left:0;right:0;height:55%;background:radial-gradient(ellipse 70% 80% at 50% 0%,rgba(50,25,100,.5) 0%,transparent 70%);pointer-events:none;}

/* lamp cone from top-right area */
.lamp-cone{position:absolute;top:0;right:18%;width:300px;height:480px;
  background:conic-gradient(from 258deg at 60% 0%,transparent 0deg,rgba(255,230,100,.04) 22deg,rgba(255,210,70,.09) 42deg,rgba(255,230,100,.04) 62deg,transparent 82deg);
  pointer-events:none;z-index:2;animation:flicker 7s ease-in-out infinite;}
@keyframes flicker{0%,100%{opacity:1;}42%{opacity:.8;}44%{opacity:.96;}46%{opacity:.75;}48%{opacity:1;}}

/* ── SCENE TITLE (top centre) ── */
.scene-title{
  position:absolute;top:3.5%;left:50%;transform:translateX(-50%);
  font-family:'Press Start 2P',monospace;font-size:clamp(10px,1.6vw,16px);
  color:#ffcc00;letter-spacing:.16em;white-space:nowrap;z-index:50;
  text-shadow:2px 2px 0 #aa8800,0 0 28px rgba(255,200,0,.7);
  animation:glow 4s ease-in-out infinite;
}
@keyframes glow{0%,100%{text-shadow:2px 2px 0 #aa8800,0 0 20px rgba(255,200,0,.4);}50%{text-shadow:2px 2px 0 #aa8800,0 0 40px rgba(255,200,0,1);}}
.scene-sub{
  position:absolute;top:calc(3.5% + 28px);left:50%;transform:translateX(-50%);
  font-family:'Press Start 2P',monospace;font-size:clamp(5px,.9vw,7px);
  color:rgba(255,200,0,.4);letter-spacing:.14em;white-space:nowrap;z-index:50;
}

/* ══════════════════════════════════════════
   STAGE — holds cabinet + desk + board
   ══════════════════════════════════════════ */
.stage{
  position:relative;
  display:flex;
  align-items:flex-end;
  gap:0;
  width:min(1200px,98vw);
  z-index:20;
  margin-top:48px;  /* push down from title */
}

/* ═══════════════════════════════════
   WALL SHELF (above desk, centred)
   ═══════════════════════════════════ */
.wall-shelf{
  position:absolute;
  bottom:calc(100% - 10px); /* sits just above desk top */
  left:320px; right:340px;  /* roughly above the desk */
  height:90px;z-index:30;
  display:flex;align-items:flex-end;padding:0 16px 10px;
}
.shelf-plank{position:absolute;bottom:0;left:0;right:0;height:12px;background:linear-gradient(180deg,#7a5228,#5a3a10);border-top:3px solid #9a6a38;box-shadow:0 5px 16px rgba(0,0,0,.8);}
.shelf-brk{position:absolute;bottom:-18px;width:10px;height:18px;background:linear-gradient(180deg,#6a4820,#4a3010);}
.shelf-brk.l{left:20px;} .shelf-brk.r{right:20px;}
.s-item{flex-shrink:0;position:relative;}
.book{width:var(--w,18px);height:var(--h,72px);background:linear-gradient(180deg,var(--tc,#c84) 0%,var(--bc,#a63) 100%);border-left:3px solid rgba(255,255,255,.15);border-right:2px solid rgba(0,0,0,.4);border-top:2px solid rgba(255,255,255,.2);box-shadow:2px 0 4px rgba(0,0,0,.5);position:relative;}
.book .sp{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:'Press Start 2P',monospace;font-size:4px;color:rgba(255,255,255,.7);writing-mode:vertical-rl;transform:rotate(180deg);}
.shelf-gap{flex:1;}
.plant-pot{width:18px;height:13px;background:linear-gradient(160deg,#c85,#a63);border:2px solid #7a4410;border-radius:0 0 3px 3px;}
.plant-stem{width:3px;height:18px;background:#2a6;margin:0 auto;position:relative;}
.leaf-l{position:absolute;top:3px;left:-9px;width:11px;height:7px;background:#2a6;border-radius:50% 0 50% 0;transform:rotate(-20deg);}
.leaf-r{position:absolute;top:7px;right:-9px;width:11px;height:7px;background:#3b7;border-radius:0 50% 0 50%;transform:rotate(20deg);}
.trophy-cup{width:18px;height:18px;background:linear-gradient(160deg,#ffd700,#b8860b);border:1px solid #8b6914;border-radius:3px 3px 0 0;}
.trophy-stem{width:4px;height:7px;background:#b8860b;border:1px solid #8b6914;margin:0 auto;}
.trophy-base{width:18px;height:5px;background:linear-gradient(180deg,#daa520,#8b6914);border:1px solid #6b4f10;border-radius:1px;}

/* ═══════════════════════════════════
   METAL FILE CABINET (left of desk)
   ═══════════════════════════════════ */
.cabinet{
  width:160px;
  height:380px;
  flex-shrink:0;
  position:relative;
  cursor:default;
  align-self:flex-end;
  margin-bottom:50px; /* sits on floor, taller than desk */
  z-index:15;
}
.cab-body{
  width:160px;height:100%;
  background:linear-gradient(160deg,#7a8090,#5a6070,#484e5c);
  border:2px solid #3a404e;border-radius:3px 3px 2px 2px;
  position:relative;
  box-shadow:
    inset -8px 0 16px rgba(0,0,0,.3),
    inset 0 -4px 8px rgba(0,0,0,.2),
    6px 6px 0 rgba(0,0,0,.6),
    8px 8px 0 rgba(0,0,0,.3);
}
/* cabinet top bevel */
.cab-body::before{content:"";position:absolute;top:0;left:0;right:0;height:10px;background:linear-gradient(180deg,#9aa0b0,#7a8090);border-radius:3px 3px 0 0;}
/* cabinet brand plate */
.cab-brand{position:absolute;top:14px;left:0;right:0;text-align:center;font-family:'Press Start 2P',monospace;font-size:4.5px;color:#2a2a3a;letter-spacing:.06em;text-shadow:0 1px 0 rgba(255,255,255,.3);}
/* DRAWERS */
.cab-drawers{display:flex;flex-direction:column;gap:4px;padding:32px 8px 8px;}
.cab-drawer{
  height:74px;
  background:linear-gradient(160deg,#6a7080,#525866);
  border:1px solid #3a404e;border-radius:2px;
  position:relative;cursor:pointer;
  box-shadow:inset 0 -2px 4px rgba(0,0,0,.3),2px 2px 0 rgba(0,0,0,.5);
  transition:transform .12s ease;
}
.cab-drawer:hover{transform:translateX(3px);}
.cab-drawer:hover .cab-hint{opacity:1;}
.cab-drawer-inner{padding:8px 10px 4px;}
.cab-dot{display:inline-block;width:5px;height:5px;border-radius:50%;margin-right:6px;vertical-align:middle;}
.cab-label{font-family:'Press Start 2P',monospace;font-size:5px;letter-spacing:.07em;text-transform:uppercase;vertical-align:middle;}
.cab-desc{font-family:'Space Mono',monospace;font-size:4.5px;color:#8a9098;letter-spacing:.04em;margin-top:4px;line-height:1.6;}
.cab-handle{width:40px;height:7px;background:linear-gradient(180deg,#ccc,#888);border:1px solid #555;border-radius:999px;margin:6px auto 0;box-shadow:0 2px 4px rgba(0,0,0,.5);}
.cab-hint{position:absolute;right:6px;top:8px;font-family:'Press Start 2P',monospace;font-size:4px;color:#ffcc00;opacity:0;transition:opacity .2s;text-shadow:0 0 6px rgba(255,200,0,.8);}
/* cabinet label strip on side */
.cab-side-label{position:absolute;left:-18px;top:50%;transform:translateY(-50%) rotate(-90deg);font-family:'Press Start 2P',monospace;font-size:5px;color:#3a404e;letter-spacing:.08em;white-space:nowrap;}

/* ═══════════════════════════════════
   DESK (centre)
   ═══════════════════════════════════ */
.desk{
  flex:1;
  position:relative;
  z-index:20;
}
/* desk top edge */
.desk-top-edge{
  width:100%;height:14px;
  background:linear-gradient(180deg,#8a6030,#6a4820,#4a3010);
  border-top:3px solid #b08040;
  box-shadow:0 3px 0 #2a1808,0 8px 24px rgba(0,0,0,.5);
}
/* desk surface (top) */
.desk-surface-top{
  width:100%;background:linear-gradient(180deg,#3d2810,#2a1c0a);
  padding:12px 20px 8px;
  display:flex;align-items:flex-end;gap:16px;
  min-height:80px;position:relative;
}
/* desk mat */
.desk-mat{
  position:absolute;bottom:0;left:80px;right:120px;height:50px;
  background:linear-gradient(160deg,#18182a,#10101e);
  border:2px solid #22223a;border-radius:3px;
  box-shadow:inset 0 0 14px rgba(0,0,20,.8);
}
/* desk front face */
.desk-front-face{
  width:100%;background:linear-gradient(160deg,#2a1c0a,#1c1206,#140e04);
  border-left:5px solid #5c3d1a;border-right:5px solid #5c3d1a;border-bottom:4px solid #3a2208;
  display:flex;align-items:stretch;min-height:220px;position:relative;
}
.desk-front-face::before{content:"";position:absolute;inset:0;pointer-events:none;
  background:repeating-linear-gradient(180deg,transparent 0,transparent 30px,rgba(255,255,255,.012) 30px,rgba(255,255,255,.012) 31px);}
/* legs */
.desk-legs{display:flex;justify-content:space-between;padding:0 40px;}
.desk-leg{width:28px;height:44px;background:linear-gradient(160deg,#3a2208,#2a1808,#1c1006);border:2px solid #5c3d1a;border-top:none;box-shadow:4px 4px 0 rgba(0,0,0,.7);position:relative;}

/* LEFT of desk front — SMALL drawers */
.desk-drawers{width:160px;border-right:3px solid #2a1808;display:flex;flex-direction:column;gap:0;padding:14px 12px;align-items:center;background:linear-gradient(160deg,#241608,#181004);}
.desk-drawer{width:130px;margin-bottom:8px;background:linear-gradient(160deg,#2e1e0c,#201408);border:2px solid #5c3d1a;border-radius:2px;position:relative;cursor:pointer;box-shadow:inset 0 -3px 6px rgba(0,0,0,.5),3px 3px 0 rgba(0,0,0,.6);transition:transform .12s;}
.desk-drawer:hover{transform:translateX(3px);}
.desk-drawer:hover .dd-hint{opacity:1;}
.dd-top{padding:7px 10px 3px;display:flex;align-items:center;gap:5px;}
.dd-dot{width:4px;height:4px;border-radius:50%;flex-shrink:0;}
.dd-name{font-family:'Press Start 2P',monospace;font-size:5px;letter-spacing:.07em;text-transform:uppercase;}
.dd-desc{font-family:'Space Mono',monospace;font-size:4.5px;color:#5a4030;letter-spacing:.04em;padding:0 10px 5px;line-height:1.6;}
.dd-handle{width:30px;height:5px;background:linear-gradient(180deg,#c8a87a,#8a6840);border:1px solid #6a4820;border-radius:999px;margin:0 auto 8px;box-shadow:0 2px 4px rgba(0,0,0,.6);}
.dd-hint{position:absolute;right:5px;top:7px;font-family:'Press Start 2P',monospace;font-size:3.5px;color:#ffcc00;opacity:0;transition:opacity .2s;text-shadow:0 0 5px rgba(255,200,0,.8);}

/* CENTRE of desk — computer stuff */
.desk-centre{flex:1;position:relative;padding:0 12px;}

/* TOWER */
.tower{position:absolute;left:16px;bottom:8px;width:65px;z-index:8;}
.tower-body{width:65px;height:160px;background:linear-gradient(160deg,#d0ccc4,#b4b0a8,#9a9690);border:2px solid #868278;border-radius:3px 3px 2px 2px;position:relative;box-shadow:inset -4px 0 8px rgba(0,0,0,.2),5px 5px 0 rgba(0,0,0,.6);}
.tower-body::before{content:"";position:absolute;top:0;left:0;right:0;height:7px;background:linear-gradient(180deg,#dedad2,#c4c0b8);border-radius:3px 3px 0 0;}
.tw-brand{position:absolute;top:12px;left:0;right:0;text-align:center;font-family:'Press Start 2P',monospace;font-size:4px;color:#666;letter-spacing:.05em;}
.tw-bays{display:flex;flex-direction:column;gap:4px;margin-top:26px;padding:0 8px;}
.tw-bay{height:10px;background:linear-gradient(160deg,#aaa,#888);border:1px solid #666;position:relative;}
.tw-bay::after{content:"";position:absolute;inset:2px;background:#555;border-radius:1px;}
.tw-leds{display:flex;gap:5px;margin:8px 0 4px 12px;}
.led{width:4px;height:4px;border-radius:50%;}
.led.g{background:#00ff41;box-shadow:0 0 5px #00ff41;animation:blink 2.3s ease-in-out infinite;}
.led.a{background:#ffb000;box-shadow:0 0 5px #ffb000;animation:blink .35s ease-in-out infinite;}
@keyframes blink{0%,100%{opacity:1;}50%{opacity:.2;}}
.tw-floppy{width:44px;height:6px;background:#333;border:1px solid #222;margin:3px auto 0;border-radius:1px;}
.tw-pwr{width:12px;height:12px;background:radial-gradient(#d8d4cc,#9e9a96);border:2px solid #888;border-radius:2px;margin:5px auto 0;box-shadow:0 2px 4px rgba(0,0,0,.5);}

/* MONITOR — clickable */
.monitor{position:relative;z-index:10;cursor:pointer;transition:filter .2s;display:inline-block;}
.monitor:hover{filter:brightness(1.12);}
.monitor:hover .htag{opacity:1;}
.mon-outer{width:220px;height:174px;background:linear-gradient(160deg,#d0ccc4,#b4b0a8,#9e9a94);border:3px solid #868278;border-radius:6px 6px 2px 2px;position:relative;box-shadow:inset -5px 0 10px rgba(0,0,0,.15),5px 5px 0 rgba(0,0,0,.6);}
.mon-outer::before{content:"";position:absolute;top:0;left:0;right:0;height:8px;background:linear-gradient(180deg,#dedad2,#c8c4bc);border-radius:6px 6px 0 0;}
.mon-brand{position:absolute;bottom:6px;left:0;right:0;text-align:center;font-family:'Press Start 2P',monospace;font-size:4px;color:#888;letter-spacing:.1em;}
.mon-led{position:absolute;bottom:6px;right:10px;width:4px;height:4px;background:#00ff41;box-shadow:0 0 4px #00ff41;border-radius:50%;animation:blink 2.4s ease-in-out infinite;}
.mon-screen{position:absolute;top:13px;left:12px;right:12px;bottom:20px;background:#001200;border:3px solid #2a2a2a;border-radius:2px;overflow:hidden;box-shadow:inset 0 0 28px rgba(0,0,0,.9);}
.mon-screen::before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse at 50% 50%,transparent 50%,rgba(0,0,0,.7) 100%);z-index:5;pointer-events:none;}
.mon-screen::after{content:"";position:absolute;inset:0;background:repeating-linear-gradient(0deg,rgba(0,0,0,.28) 0,rgba(0,0,0,.28) 1px,transparent 1px,transparent 2px);z-index:6;pointer-events:none;}
.mon-idle{padding:7px 8px;font-family:'Space Mono',monospace;font-size:7px;color:#00ff41;line-height:1.9;text-shadow:0 0 5px rgba(0,255,65,.9);position:relative;z-index:4;}
.mon-idle .d{color:#005510;} .mon-idle .am{color:#ffb000;text-shadow:0 0 5px rgba(255,176,0,.8);}
.cur{display:inline-block;width:6px;height:11px;background:#00ff41;animation:blink .9s step-end infinite;vertical-align:middle;box-shadow:0 0 5px #00ff41;}
/* OS desktop shown after boot */
.mon-os{display:none;position:absolute;inset:0;z-index:4;background:linear-gradient(135deg,#1a3a6a 0%,#2a5a8a 50%,#1a4a6a 100%);padding:6px;}
.os-taskbar{position:absolute;bottom:0;left:0;right:0;height:16px;background:linear-gradient(180deg,#c0b8b0,#a8a0a0);border-top:1px solid #888;display:flex;align-items:center;padding:0 4px;gap:4px;}
.os-start{font-family:'Press Start 2P',monospace;font-size:4px;color:#000;background:linear-gradient(180deg,#d0c8c0,#a8a0a0);border:1px solid #555;padding:2px 4px;border-radius:1px;cursor:pointer;}
.os-time{font-family:'Press Start 2P',monospace;font-size:4px;color:#000;margin-left:auto;border:1px solid #888;padding:1px 4px;background:#c0b8b0;}
.os-icons{display:grid;grid-template-columns:repeat(2,1fr);gap:6px;padding:4px;width:80px;}
.os-icon{display:flex;flex-direction:column;align-items:center;gap:2px;cursor:pointer;padding:3px;border-radius:2px;border:1px solid transparent;transition:background .1s;}
.os-icon:hover{background:rgba(255,255,255,.15);border-color:rgba(255,255,255,.4);}
.os-icon-img{font-size:14px;line-height:1;}
.os-icon-label{font-family:'Press Start 2P',monospace;font-size:3px;color:#fff;text-shadow:1px 1px 0 #000;text-align:center;letter-spacing:.02em;line-height:1.3;}
.mon-neck{width:32px;height:18px;background:linear-gradient(180deg,#b4b0a8,#969290);border:2px solid #868278;border-top:none;margin:0 auto;box-shadow:3px 2px 0 rgba(0,0,0,.5);}
.mon-stand{width:95px;height:13px;background:linear-gradient(180deg,#c0bcb4,#9e9a96);border:2px solid #868278;border-radius:2px;margin:0 auto;box-shadow:4px 4px 0 rgba(0,0,0,.5);}

/* keyboard + mouse */
.keyboard{width:185px;height:38px;background:linear-gradient(160deg,#cac6be,#aeaaa4);border:2px solid #868278;border-radius:3px 3px 4px 4px;position:relative;margin-top:3px;box-shadow:inset 0 2px 4px rgba(255,255,255,.2),3px 3px 0 rgba(0,0,0,.6);}
.keyboard::before{content:"";position:absolute;top:6px;left:6px;right:6px;height:5px;background:repeating-linear-gradient(90deg,#9e9a96 0,#9e9a96 8px,#b0aca6 8px,#b0aca6 10px);border-radius:1px;}
.keyboard::after{content:"";position:absolute;top:15px;left:6px;right:6px;height:5px;background:repeating-linear-gradient(90deg,#9e9a96 0,#9e9a96 8px,#b0aca6 8px,#b0aca6 10px);border-radius:1px;}
.spacebar{position:absolute;bottom:6px;left:50%;transform:translateX(-50%);width:60px;height:5px;background:#9e9a96;border:1px solid #868278;border-radius:1px;}
.mouse-obj{width:24px;height:34px;background:linear-gradient(160deg,#cac6be,#a6a29e);border:2px solid #868278;border-radius:10px 10px 8px 8px;position:absolute;bottom:28px;right:20px;box-shadow:3px 3px 0 rgba(0,0,0,.6);}
.mouse-obj::before{content:"";position:absolute;top:5px;left:50%;transform:translateX(-50%);width:1px;height:12px;background:#868278;}

/* dossier folder on desk */
.dossier-desk{position:absolute;bottom:30px;right:28px;z-index:15;cursor:pointer;transition:transform .15s;}
.dossier-desk:hover{transform:rotate(4deg) translateY(-4px);}
.dossier-desk:hover .htag{opacity:1;}
.folder-b{width:68px;height:54px;background:linear-gradient(160deg,#c8973a,#a87820);border:2px solid #8a6010;position:relative;box-shadow:3px 3px 0 rgba(0,0,0,.6);transform:rotate(-4deg);}
.folder-b::before{content:"";position:absolute;top:-10px;left:0;width:32px;height:12px;background:linear-gradient(160deg,#c8973a,#a87820);border:2px solid #8a6010;border-bottom:none;border-radius:3px 5px 0 0;}
.folder-lbl{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:'Space Mono',monospace;font-size:4px;color:#3a1a00;letter-spacing:.1em;font-weight:700;text-align:center;gap:2px;}

/* RIGHT of desk front */
.desk-right{width:140px;border-left:3px solid #2a1808;background:linear-gradient(160deg,#1e1408,#161006);display:flex;flex-direction:column;align-items:center;padding:12px 10px;gap:8px;}
/* papers on desk right */
.papers{position:relative;width:120px;height:62px;cursor:pointer;transition:transform .15s;}
.papers:hover{transform:translateY(-3px);}
.papers:hover .htag{opacity:1;}
.paper{position:absolute;background:linear-gradient(135deg,#f5f0e0,#ede7ce);border:1px solid #d4c89a;box-shadow:2px 2px 0 rgba(0,0,0,.5);}
.p1{width:105px;height:58px;left:0;top:0;transform:rotate(-5deg);}
.p2{width:100px;height:56px;left:8px;top:5px;transform:rotate(2deg);}
.p3{width:104px;height:56px;left:3px;top:2px;}
.p-lines{padding:6px;font-family:'Space Mono',monospace;font-size:4px;color:#8a7a5a;line-height:2.2;}
.p-lines .rl{color:#a93e3e;}
.p-stamp{position:absolute;bottom:4px;right:3px;font-family:'Space Mono',monospace;font-size:3.5px;color:#a93e3e;border:1px solid #a93e3e;padding:1px 3px;transform:rotate(7deg);}
/* sticky note */
.sticky-desk{width:115px;background:#ffe066;border:1px solid #e6c800;box-shadow:2px 3px 0 rgba(0,0,0,.5);padding:7px 9px;transform:rotate(-1.5deg);cursor:pointer;transition:transform .15s;position:relative;}
.sticky-desk:hover{transform:rotate(0deg) translateY(-2px);}
.sticky-desk:hover .htag{opacity:1;}
.sticky-txt{font-family:'Caveat',cursive;font-size:12px;color:#2a2000;line-height:1.5;}
/* mug */
.mug-wrap{position:relative;}
.mug{width:30px;height:32px;background:linear-gradient(160deg,#dedad2,#aeaaa4);border:2px solid #888;border-radius:2px 2px 4px 4px;position:relative;box-shadow:3px 3px 0 rgba(0,0,0,.6);}
.mug::before{content:"";position:absolute;right:-8px;top:6px;width:8px;height:15px;border:2px solid #888;border-left:none;border-radius:0 4px 4px 0;}
.mug::after{content:"T";position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-family:'Press Start 2P',monospace;font-size:6px;color:rgba(80,60,30,.45);}
.steam{position:absolute;top:-11px;left:7px;font-size:9px;color:rgba(255,255,255,.15);animation:stm 3s ease-in-out infinite;}
@keyframes stm{0%,100%{transform:translateY(0);opacity:.15;}50%{transform:translateY(-4px);opacity:.05;}}

/* ═══════════════════════════════════
   CORK / DETECTIVE BOARD (right)
   ═══════════════════════════════════ */
.cork-board{
  width:340px;
  height:420px;
  flex-shrink:0;
  position:relative;
  align-self:flex-end;
  margin-bottom:50px;
  z-index:15;
}
/* board frame */
.board-frame{
  width:100%;height:100%;
  background:#2a1808;
  border:6px solid #3a2208;
  border-radius:4px;
  position:relative;
  box-shadow:
    inset 0 0 0 2px #4a3010,
    8px 8px 0 rgba(0,0,0,.7),
    10px 10px 0 rgba(0,0,0,.35);
}
/* cork texture */
.board-cork{
  position:absolute;inset:6px;
  background:
    radial-gradient(ellipse 2px 2px at 15% 22%, rgba(120,90,50,.6) 0%, transparent 100%),
    radial-gradient(ellipse 2px 2px at 45% 68%, rgba(120,90,50,.4) 0%, transparent 100%),
    radial-gradient(ellipse 2px 2px at 72% 35%, rgba(100,70,40,.5) 0%, transparent 100%),
    radial-gradient(ellipse 2px 2px at 88% 80%, rgba(110,80,45,.4) 0%, transparent 100%),
    linear-gradient(135deg,#8B6340 0%,#7a5530 30%,#8B6340 60%,#7a5530 100%);
  border-radius:2px;
  overflow:hidden;
}
/* board header */
.board-header{
  position:absolute;top:8px;left:0;right:0;text-align:center;z-index:10;
}
.board-title{font-family:'Press Start 2P',monospace;font-size:6px;color:#ffcc00;letter-spacing:.1em;text-shadow:0 0 8px rgba(255,200,0,.6);}
/* SVG strings layer */
.strings-svg{position:absolute;inset:0;z-index:2;pointer-events:none;overflow:visible;}

/* PINNED NOTES */
.pin-note{
  position:absolute;z-index:5;cursor:pointer;
  transition:transform .15s ease,filter .15s ease;
}
.pin-note:hover{transform:var(--hover-t,scale(1.04));filter:brightness(1.1);}
.pin-note:hover .htag{opacity:1;}
/* pushpin */
.pushpin{
  position:absolute;top:-8px;left:50%;transform:translateX(-50%);
  width:10px;height:10px;border-radius:50%;
  background:radial-gradient(circle at 35% 35%,var(--pin-hi,#ff6666),var(--pin-c,#cc2200));
  box-shadow:0 0 6px var(--pin-c,#cc2200),1px 1px 0 rgba(0,0,0,.5);
  z-index:6;
}
.pushpin::after{content:"";position:absolute;bottom:-5px;left:50%;transform:translateX(-50%);width:2px;height:5px;background:#888;}
/* note card styles */
.nc{padding:8px 9px;border-radius:1px;box-shadow:2px 3px 6px rgba(0,0,0,.5);position:relative;}
.nc.yellow{background:#ffe566;border:1px solid #e6c800;}
.nc.white{background:#f5f5f0;border:1px solid #d0ccc0;}
.nc.pink{background:#ffc0cc;border:1px solid #e090a0;}
.nc.blue{background:#b8deff;border:1px solid #70a8e0;}
.nc.green{background:#b8f0cc;border:1px solid #60c880;}
.nc.orange{background:#ffd0a0;border:1px solid #e0a060;}
.nc-title{font-family:'Caveat',cursive;font-size:13px;font-weight:700;color:#1a1a00;line-height:1.3;margin-bottom:3px;}
.nc.white .nc-title,.nc.white .nc-sub{color:#1a1a1a;}
.nc.pink .nc-title,.nc.pink .nc-sub{color:#2a0010;}
.nc.blue .nc-title,.nc.blue .nc-sub{color:#001030;}
.nc.green .nc-title,.nc.green .nc-sub{color:#001a10;}
.nc.orange .nc-title,.nc.orange .nc-sub{color:#2a1000;}
.nc-sub{font-family:'Space Mono',monospace;font-size:7px;color:#5a5000;margin-top:4px;border-top:1px dashed rgba(0,0,0,.18);padding-top:3px;letter-spacing:.04em;}
/* photo/image note */
.nc.photo{background:#222;border:3px solid #ddd;padding:4px;}
.nc.photo .photo-inner{width:100%;background:linear-gradient(135deg,#334,#223);display:flex;align-items:center;justify-content:center;font-size:20px;}

/* ═════════════════════
   HOTSPOT TAGS
   ═════════════════════ */
.htag{
  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
  font-family:'Press Start 2P',monospace;font-size:5px;
  color:#ffcc00;background:rgba(0,0,0,.85);
  border:1px solid #ffcc00;padding:4px 8px;border-radius:2px;
  white-space:nowrap;opacity:0;transition:opacity .2s;
  pointer-events:none;z-index:60;
  text-shadow:0 0 8px rgba(255,200,0,.8);
}

/* ═══════════════════════════════════
   BOOT SCREEN
   ═══════════════════════════════════ */
#boot-screen{
  position:fixed;inset:0;z-index:900;background:#050505;
  display:none;flex-direction:column;align-items:center;justify-content:center;
}
#boot-screen.active{display:flex;}
.boot-lines{width:min(620px,90vw);font-size:13px;line-height:1;}
.boot-line{font-family:'Space Mono',monospace;color:#00ff41;text-shadow:0 0 6px rgba(0,255,65,.8);
  opacity:0;transform:translateY(3px);transition:opacity .25s,transform .25s;margin-bottom:6px;}
.boot-line.show{opacity:1;transform:translateY(0);}
.boot-line.d{color:#005510;} .boot-line.am{color:#ffb000;text-shadow:0 0 6px rgba(255,176,0,.8);}
.boot-line.er{color:#ff4444;text-shadow:0 0 6px rgba(255,68,68,.8);}
.boot-prog{width:min(620px,90vw);height:3px;background:#001400;margin-top:18px;border-radius:2px;overflow:hidden;}
.boot-bar{height:100%;width:0%;background:#00ff41;box-shadow:0 0 8px #00ff41;transition:width .1s linear;}
.boot-skip{position:absolute;bottom:24px;right:32px;font-family:'Press Start 2P',monospace;font-size:7px;color:rgba(0,255,65,.4);cursor:pointer;letter-spacing:.1em;}
