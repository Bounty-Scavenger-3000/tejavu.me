.findings{display:flex;flex-direction:column;gap:12px;}
.finding{display:grid;grid-template-columns:100px 1fr 96px;gap:16px;align-items:start;padding:16px 20px;border-left:4px solid;background:#fff;box-shadow:0 1px 4px rgba(0,0,0,.07);}
.finding.str{border-color:#1a5c3a;} .finding.amb{border-color:#c07a00;} .finding.rsk{border-color:#8b1a1a;}
